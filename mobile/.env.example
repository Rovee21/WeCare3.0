# Copy to .env and adjust for your setup. Expo loads EXPO_PUBLIC_* vars automatically.
#
# Defaults to http://localhost:8000, which works for the iOS Simulator (it shares
# the host's network namespace) against `docker-compose up` in backend/.
#
# Physical device on the same LAN:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
#
# Android emulator (needs the special alias for host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
